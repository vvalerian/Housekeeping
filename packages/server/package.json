  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "@housekeeping/core": "*",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.5",
    "tsx": "^4.20.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
