{
  "name": "@housekeeping/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backup": "tsx src/db/sauvegarde.ts",
    "db:mot-de-passe": "tsx src/db/mot-de-passe.ts",
    "db:generate": "drizzle-kit generate",
